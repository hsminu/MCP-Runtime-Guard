# Fill OPENAI_API_KEY in the untracked .env file.
# Cisco Scanner uses python-dotenv interpolation for this key alias.
OPENAI_API_KEY=
MCP_SCANNER_LLM_API_KEY=${OPENAI_API_KEY}

# Selected model for the Cisco Scanner LLM analyzer.
MCP_SCANNER_LLM_MODEL=openai/gpt-6-luna
# Project adapter/probe setting; upstream Scanner 4.8.6 CLI ignores it.
MCP_SCANNER_LLM_REASONING_EFFORT=low
MCP_SCANNER_LLM_BASE_URL=https://api.openai.com/v1
MCP_SCANNER_LLM_TIMEOUT=60
MCP_SCANNER_DEFAULT_LLM_MAX_TOKENS=4096
# The adapter must omit temperature for Luna low.

# Load .env before importing Scanner/LiteLLM; see the setup document.
LITELLM_LOCAL_MODEL_COST_MAP=True
